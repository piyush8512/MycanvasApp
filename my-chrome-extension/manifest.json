{
  "manifest_version": 3,
  "minimum_chrome_version": "114",
  "name": "Canvas",
  "version": "1.0.2",
  "description": "Save links, text, and images directly to your Canvas.",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "notifications",
    "contextMenus"
  ],
  "host_permissions": [
    "https://mycanvas-app-backend.vercel.app/*",
    "http://localhost:4000/*",
    "http://127.0.0.1:4000/*",
    "http://192.168.1.33:4000/*",
    "https://mycanvas-app-seven.vercel.app/*"
  ],
  "action": {
    "default_title": "Canvas"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content/sticky-saver.js"
      ],
      "css": [
        "content/sticky-saver.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "save-to-canvas": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Quick save to last canvas"
    }
  },
  "externally_connectable": {
    "matches": [
      "http://localhost:3000/*",
      "http://localhost:3001/*",
      "http://127.0.0.1:3000/*",
      "http://127.0.0.1:3001/*",
      "http://192.168.1.33:3000/*",
      "https://mycanvas-app-seven.vercel.app/*"
    ]
  }
}